# Lead-Lag Arbitrage Engine Configuration

[engine]
min_profit_wei = 10000000000000000    # 0.01 ETH minimum profit
max_gas_limit = 5000000               # 5M gas max per tx
ring_buffer_size = 1024              # SPSC channel capacity
simulation_timeout_ms = 500           # REVM simulation timeout
max_concurrent_simulations = 4        # Max parallel simulations

[binance]
ws_url = "wss://stream.binance.com:9443/ws"
symbols = ["ethusdt", "wbtcusdt"]
reconnect_delay_ms = 1000
max_reconnect_attempts = 10

